---
import club from '../data/club.json';
import Icon from '../components/Icon.astro';
import scienceNetwork from '../../public/illustrations/science-network.svg?raw';
import '../styles/global.css';

const isReady = Object.values(club.release).every(Boolean);
const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
type Person = { name: string; role: string; url?: string | null; photo?: string | null; approvedForPublicUse: boolean };
const people = (club.people as Person[]).filter(person => person.approvedForPublicUse);
const activityStatus = { planning: 'In preparation', upcoming: 'Upcoming', completed: 'Past event' };
const initials = (name: string) => name.trim().split(/\s+/).slice(0, 2).map(part => part[0]).join('');
const focusIcons = ['flask-conical', 'orbit', 'terminal'] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={club.description} />
    <meta name="theme-color" content="#f5f2eb" />
    {!isReady && <meta name="robots" content="noindex, nofollow" />}
    {Astro.site && <link rel="canonical" href={new URL(home, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
    <title>{club.name} | AI4Chem Club</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="university-link" href="https://www.ust.hk/" aria-label="HKUST home">
        <img src={`${home}branding/hkust-logo.svg`} width="150" height="48" alt="HKUST — The Hong Kong University of Science and Technology" />
      </a>
      <a class="wordmark" href={home} aria-label={`${club.shortName} home`}>{club.shortName}</a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        {club.activities.length > 0 && <a href="#activities">Activities</a>}
        <a href="#members">Members</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main" class="page-shell" tabindex="-1">
      <section class="introduction" aria-labelledby="club-title">
        <div>
          <p class="identity-line">{club.affiliation.label}</p>
          <h1 id="club-title">{club.name}</h1>
        </div>
        <div class="introduction-summary">
          <p class="description">{club.description}</p>
          <a class="primary-link" href="#about">About the club</a>
        </div>
      </section>

      <div class:list={['showcase', { 'showcase-solo': club.activities.length === 0 }]}>
        <div class="visual-panel">
          <div class="visual-heading">
            <span>{club.focusAreas[0].title}</span>
            <span class="visual-colors" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <div class="visual-stage">
            <div class="science-art" aria-hidden="true"><Fragment set:html={scienceNetwork} /></div>
            <p class="tagline">{club.tagline.join(' ')}</p>
          </div>
          <div class="interest-links" aria-label="Explore the club's interests">
            {club.focusAreas.map((area, index) => (
              <a href={`#focus-${index}`}><Icon name={focusIcons[index] ?? 'orbit'} /><span>{area.title}</span></a>
            ))}
          </div>
        </div>

        {club.activities.length > 0 && (
          <section id="activities" class="activity-panel" aria-labelledby="activities-title">
            <h2 id="activities-title">Activities &amp; updates</h2>
            <div class="activity-list">
              {club.activities.map(activity => (
                <article class="activity">
                  <div class="activity-meta">
                    <span class:list={['status', `status-${activity.status}`]}>{activityStatus[activity.status as keyof typeof activityStatus]}</span>
                    {activity.relationship === 'external-participation' && <p>Club participation in an external event</p>}
                    {activity.date && <p><time datetime={activity.date}>{activity.date}</time></p>}
                    {activity.location && <p>{activity.location}</p>}
                  </div>
                  <h3>{activity.title}</h3>
                  <p class="activity-summary">{activity.summary}</p>
                  {activity.url && <a class="text-link" href={activity.url}>Event details</a>}
                </article>
              ))}
            </div>
            <p class="activities-intro">{club.activitiesIntro}</p>
          </section>
        )}
      </div>

      <section id="about" class="about-panel content-section" aria-labelledby="about-title">
        <div class="section-heading"><h2 id="about-title">About the club</h2></div>
        <div class="about-introduction">
          <p class="about-copy">{club.about}</p>
          <p class="affiliation">{club.affiliation.text}</p>
        </div>
        <div class="focus-grid">
          {club.focusAreas.map((area, index) => (
            <article id={`focus-${index}`} class="focus-item">
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </article>
          ))}
        </div>
        <p class="learning-note">{club.learningNote}</p>
      </section>

      <section id="members" class="members-section content-section" aria-labelledby="members-title">
        <div class="section-heading">
          <h2 id="members-title">Members</h2>
          <p>A community of students learning together, with support and guidance from our faculty advisor.</p>
        </div>
        {people.length > 0 ? <div class="members-grid">
          {people.map(person => (
            <article class="member-card">
              <div class="member-portrait">
                {person.photo
                  ? <img src={`${home}${person.photo}`} alt="" width="160" height="160" loading="lazy" />
                  : <span class="member-initials" aria-hidden="true">{initials(person.name)}</span>}
              </div>
              <div class="member-details">
                <h3>{person.name}</h3>
                <p class="member-role">{person.role}</p>
                {person.url && <a class="text-link" href={person.url}>Personal website</a>}
              </div>
            </article>
          ))}
        </div> : <p class="members-pending">Member profiles coming soon.</p>}
      </section>

      <section id="contact" class="contact-panel" aria-labelledby="contact-title">
        <div>
          <h2 id="contact-title">Contact</h2>
          <p>Have a question about the club or an idea to share? We'd like to hear from you.</p>
        </div>
        <a class="contact-email" href={`mailto:${club.contactEmail}`}><Icon name="mail" /><span>{club.contactEmail}</span></a>
      </section>
    </main>

    <footer class="site-footer page-shell">
      <div><p>{club.name}</p><p>A student-led academic community for AI and science.</p></div>
      <div class="footer-links">
        <details class="design-credits">
          <summary>Design credits</summary>
          <p>Interface styles adapted from <a href="https://github.com/AI4QC/FLEX">FLEX</a> (<a href={`${home}licenses/FLEX-MIT.txt`}>MIT</a>) and <a href="https://github.com/AI4QC/materia-viva">Materia Viva</a> (<a href={`${home}licenses/Materia-Viva-CC-BY-NC-4.0.txt`}>CC BY-NC 4.0</a>). Layout, colours and content adapted for AI4Chem Club.</p>
          <p>Icons from <a href="https://github.com/lucide-icons/lucide">Lucide</a> (<a href={`${home}licenses/Lucide-LICENSE.txt`}>ISC / MIT notices</a>).</p>
        </details>
        <a href="#main"><Icon name="chevron-up" />Back to top</a>
      </div>
    </footer>
  </body>
</html>

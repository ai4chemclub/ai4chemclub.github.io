---
import club from '../data/club.json';
import '../styles/global.css';

const isReady = Object.values(club.release).every(Boolean);
const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
type Person = { name: string; role: string; url?: string | null; approvedForPublicUse: boolean };
const people = (club.people as Person[]).filter(person => person.approvedForPublicUse);
const activityStatus = { planning: 'In preparation', upcoming: 'Upcoming', completed: 'Past event' };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={club.description} />
    <meta name="theme-color" content="#173bef" />
    {!isReady && <meta name="robots" content="noindex, nofollow" />}
    {Astro.site && <link rel="canonical" href={new URL(home, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
    <title>{club.shortName} — AI for Chemistry Club</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={home} aria-label={`${club.shortName} home`}>
        <span class="wordmark-icon" aria-hidden="true">a<span>i</span></span>
        <span>AI4Chem <strong>Club</strong></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        {club.activities.length > 0 && <a href="#activities">Activities</a>}
        {people.length > 0 && <a href="#people">People</a>}
        <a class="nav-contact" href="#contact">Say hello <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-intro">
          <p class="eyebrow">AI for Chemistry Club</p>
          <h1 id="hero-title" aria-label={club.tagline.join(' ')}>{club.tagline.map((line, index) => <span class:list={{ 'hero-accent': index >= 2 }}>{line}</span>)}</h1>
          <p class="hero-description">{club.description}</p>
          <a class="button button-dark" href="#about">Meet the club <span aria-hidden="true">↘</span></a>
        </div>
        <div class="topic-board" aria-label="Our shared interests: chemistry, science, and artificial intelligence">
          <div class="board-note">A place to learn.<br />A reason to explore.</div>
          <div class="board-type" aria-hidden="true"><span>AI</span><span class="multiply">×</span><span class="chem">CHEM</span></div>
          <div class="board-bottom"><span>Big questions.<br />Shared curiosity.</span><span class="board-star" aria-hidden="true">✳</span></div>
        </div>
      </section>

      <section id="about" class="section about-section" aria-labelledby="about-title">
        <div class="section-heading"><p class="eyebrow">01 / About us</p><h2 id="about-title">Start with chemistry.<br />Keep exploring.</h2></div>
        <div class="about-copy"><p>{club.about}</p>{club.affiliation.approvedForPublicUse && <p class="affiliation">{club.affiliation.text}</p>}</div>
        <div class="focus-grid">
          {club.focusAreas.map((area, index) => <article class="focus-item"><span class="focus-number" aria-hidden="true">0{index + 1}</span><h3>{area.title}</h3><p>{area.description}</p></article>)}
        </div>
      </section>

      {club.activities.length > 0 && <section id="activities" class="section activities-section" aria-labelledby="activities-title">
        <div class="section-heading"><p class="eyebrow">02 / Activities & updates</p><h2 id="activities-title">Learning starts<br />with showing up.</h2></div>
        <div class="activity-list">
          {club.activities.map(activity => <article class="activity">
            <div class="activity-meta"><span class="status">{activityStatus[activity.status as keyof typeof activityStatus]}</span>{activity.relationship === 'external-participation' && <span>Club participation in an external event</span>}</div>
            <h3>{activity.title}</h3><p>{activity.summary}</p>
            {activity.date && <p><time datetime={activity.date}>{activity.date}</time>{activity.location && ` · ${activity.location}`}</p>}
            {activity.url && <a class="text-link" href={activity.url}>Event details <span aria-hidden="true">↗</span></a>}
          </article>)}
        </div>
      </section>}

      {people.length > 0 && <section id="people" class="section people-section" aria-labelledby="people-title">
        <div class="section-heading"><p class="eyebrow">People</p><h2 id="people-title">The people behind<br />the club.</h2></div>
        <div class="people-grid">{people.map(person => <article><p class="eyebrow">{person.role}</p><h3>{person.name}</h3>{person.url && <a class="text-link" href={person.url}>Personal website <span aria-hidden="true">↗</span></a>}</article>)}</div>
      </section>}

      <section id="contact" class="contact-section" aria-labelledby="contact-title">
        <div><p class="eyebrow">Let's connect</p><h2 id="contact-title">Bring your curiosity.</h2><p>Interested in the club, or have an idea to share? Get in touch.</p></div>
        <a class="contact-email" href={`mailto:${club.contactEmail}`}>{club.contactEmail}<span aria-hidden="true">↗</span></a>
      </section>
    </main>
    <footer class="site-footer"><span>{club.name}</span><a href="#main">Back to top ↑</a></footer>
  </body>
</html>
